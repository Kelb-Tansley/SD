<UserControl
    x:Class="SD.UI.Tools.Views.TankDesignView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:SD.UI.Tools.ViewModels"
    xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    d:DataContext="{d:DesignInstance Type=viewmodels:TankDesignViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding UnloadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SD.UI;component/Styles/Global.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WindowsFormsHost Margin="8,8,16,8" MinWidth="500" Grid.Column="0" Grid.RowSpan="2" Visibility="{Binding IsModelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <wf:PictureBox x:Name="FemModelPanel" SizeChanged="FemModelPanel_SizeChanged" />
        </WindowsFormsHost>
        <StackPanel Grid.Column="1" VerticalAlignment="Stretch" ScrollViewer.CanContentScroll="True" materialDesign:ScrollBarAssist.ButtonsVisibility="Visible">
            <TextBlock
                Margin="0,4,0,16"
                Foreground="{StaticResource MaterialDesignLightForeground}"
                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                Text="Cylindrical Tank Design" />
            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left" Width="320" Text="This tool builds a plate element model based on the specified load cases and design parameters." />
            <StackPanel
                Margin="0,12,0,12"
                HorizontalAlignment="Stretch"
                Orientation="Horizontal">
                <TextBlock
                    MinWidth="180"
                    Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                    Text="Diameter (mm):" />
                <TextBox
                    MinWidth="100"
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    Style="{StaticResource MaterialDesignTextBox}"
                    Text="{Binding TankDiameter}" />
            </StackPanel>
            <StackPanel
     Margin="0,12,0,12"
     HorizontalAlignment="Stretch"
     Orientation="Horizontal">
                <TextBlock
         MinWidth="180"
         Margin="0,0,8,0"
         Style="{StaticResource MaterialDesignCaptionTextBlock}"
         Text="Mesh element size (mm):" />
                <TextBox
         MinWidth="100"
         materialDesign:TextFieldAssist.HasClearButton="True"
         Style="{StaticResource MaterialDesignTextBox}"
         Text="{Binding MeshElementSize}" />
            </StackPanel>
            <StackPanel
     Margin="0,12,0,12"
     HorizontalAlignment="Stretch"
     Orientation="Horizontal">
                <TextBlock
         MinWidth="180"
         Margin="0,0,8,0"
         Style="{StaticResource MaterialDesignCaptionTextBlock}"
         Text="Mesh element type:" />
                <ComboBox IsEditable="False" SelectedIndex="1"
         MinWidth="100" SelectedValuePath="{Binding PlateElementCount}"
  materialDesign:HintAssist.Hint="Plate nodes">
                    <ComboBoxItem     Content="4 Node" />
                </ComboBox>
            </StackPanel>
            <StackPanel CanVerticallyScroll="True"
     Margin="0,16,0,12"
     HorizontalAlignment="Stretch">
                <DataGrid CanUserAddRows="True"  HorizontalAlignment="Stretch"
  SelectionUnit="Cell" AutoGenerateColumns="False" CanUserReorderColumns="True"
  ItemsSource="{Binding Segments}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
        Binding="{Binding Order}" 
        Header="Order" />
                        <DataGridTextColumn
        Binding="{Binding Height}" 
        Header="Segment Height" />
                        <DataGridTextColumn
        Binding="{Binding Thickness}" 
        Header="Plate Thickness">
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Margin="8" HorizontalAlignment="Right"
  Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                Command="{Binding AddHeightSegmentCommand}"
  ToolTip="Add Row">
                    <materialDesign:PackIcon
    Width="22"
    Height="22"
    Kind="Plus" />
                </Button>
            </StackPanel>
        </StackPanel>
        <StackPanel
            Grid.Row="1" Grid.Column="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="100"
                Margin="12"
                Command="{Binding GenerateCommand}"
                Content="Generate"
                Style="{StaticResource MaterialDesignRaisedButton}"
                ToolTip="Generate tank model." />
            <Button
                Width="100"
                Margin="12"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                Style="{StaticResource MaterialDesignOutlinedButton}" />
        </StackPanel>
    </Grid>
</UserControl>
