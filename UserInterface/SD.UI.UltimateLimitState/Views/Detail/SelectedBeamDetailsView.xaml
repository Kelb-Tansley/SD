<UserControl
    x:Class="SD.UI.UltimateLimitState.Views.SelectedBeamDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SD.UI.Controls;assembly=SD.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:SD.UI.Selectors;assembly=SD.UI"
    xmlns:viewmodels="clr-namespace:SD.UI.UltimateLimitState.ViewModels"
    xmlns:views="clr-namespace:SD.UI.UltimateLimitState.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:FemModelViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SD.UI;component/Styles/Global.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SecondaryLight7}" />
                <Setter Property="BorderBrush" Value="{StaticResource SecondaryLight5}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Margin" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <DataTemplate x:Key="SansDetailsView">
                <ScrollViewer
                    DataContext="{Binding Path=DataContext.SelectedBeamResult, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}, AncestorLevel=2}}"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <!--  SANS  -->
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <views:BeamHeaderCardView />
                        </Border>
                        <Border Background="Transparent" Style="{StaticResource CardBorder}">
                            <controls:ExpandingCard ExpanderTitle="Effective Length" IsExpanded="True">
                                <views:BeamEffectiveLengthView />
                            </controls:ExpandingCard>
                        </Border>
                        <Border Background="Transparent" Style="{StaticResource CardBorder}">
                            <controls:ExpandingCard ExpanderTitle="Member Capacity">
                                <views:BeamCapacityView />
                            </controls:ExpandingCard>
                        </Border>
                        <Border Background="Transparent" Style="{StaticResource CardBorder}">
                            <controls:ExpandingCard ExpanderTitle="ULS Utilization">
                                <views:BeamUtilizationView />
                            </controls:ExpandingCard>
                        </Border>
                        <Border Background="Transparent" Style="{StaticResource CardBorder}">
                            <controls:ExpandingCard ExpanderTitle="Section Properties">
                                <views:BeamSectionProperties />
                            </controls:ExpandingCard>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

            <DataTemplate x:Key="ASDetailsView">
                <ScrollViewer
                    DataContext="{Binding Path=DataContext.SelectedBeamResult, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}, AncestorLevel=2}}"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <!--  AS  -->
                    <StackPanel TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                        <Expander
                            HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                            BorderThickness="0,0,0,1"
                            Header="Effective Length">
                            <views:BeamEffectiveLengthView Margin="8" />
                        </Expander>
                        <Expander
                            HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                            BorderThickness="0,0,0,1"
                            Header="ULS Utilisation">
                            <views:ASBeamUtilisationView Margin="8" />
                        </Expander>
                        <Expander
                            HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                            BorderThickness="0,0,0,1"
                            Header="ULS Capacity">
                            <views:ASBeamCapacityView Margin="8" />
                        </Expander>
                        <Expander
                            HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                            BorderThickness="0,0,0,1"
                            Header="Section Properties">
                            <views:ASBeamSectionProperties Margin="8" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

            <selectors:UlsDetailsDesignCodeSelector
                x:Key="UlsDetailsDesignCodeSelector"
                ASDetailsDataTemplate="{StaticResource ASDetailsView}"
                SansDetailsDataTemplate="{StaticResource SansDetailsView}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ContentPresenter
            Content="{Binding Path=DataContext.SelectedDesignCode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}, AncestorLevel=2}}"
            ContentTemplateSelector="{StaticResource UlsDetailsDesignCodeSelector}"
            DataContext="{Binding Path=DataContext.SelectedDesignCode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}, AncestorLevel=2}}" />
    </Grid>
</UserControl>
