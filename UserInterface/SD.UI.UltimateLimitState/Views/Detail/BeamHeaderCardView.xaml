<UserControl
    x:Class="SD.UI.UltimateLimitState.Views.BeamHeaderCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border MinHeight="80">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <!--  Left: Peak utilization  -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock
                    FontSize="{StaticResource ControlFontSize}"
                    FontWeight="Normal"
                    Foreground="{StaticResource PrimaryLight1}"
                    Text="Peak utilization" />

                <TextBlock
                    Margin="0,2,0,4"
                    FontSize="{StaticResource HeaderFontSize}"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryLight1}"
                    Text="{Binding Utilization.MaxUtilization, Converter={StaticResource DoubleToPercentageConverter}}" />

                <StackPanel Margin="0,4,0,0" HorizontalAlignment="Left">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryLight2}"
                        Text="Section:" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryColor}"
                        Text="{Binding Beam.Section.DisplayName}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!--  Right: Reason and small KPIs  -->
            <StackPanel
                Grid.Column="1"
                Margin="8,0,0,0"
                HorizontalAlignment="Stretch"
                Orientation="Vertical">
                <StackPanel Margin="0,4,0,0" HorizontalAlignment="Stretch">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryLight2}"
                        Text="Reason:" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryColor}"
                        Text="{Binding Utilization.MaxUtilizationDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>