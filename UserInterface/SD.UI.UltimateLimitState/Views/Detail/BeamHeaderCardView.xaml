<UserControl
    x:Class="SD.UI.UltimateLimitState.Views.BeamHeaderCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border MinHeight="80">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left: Peak utilization  -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock
                    FontSize="{StaticResource ControlFontSize}"
                    FontWeight="Normal"
                    Foreground="{StaticResource PrimaryLight1}"
                    Text="Peak utilization" />

                <TextBlock
                    Margin="0,2,0,4"
                    FontSize="{StaticResource HeaderFontSize}"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryLight1}"
                    Text="{Binding Utilization.MaxUtilization, Converter={StaticResource DoubleToPercentageConverter}}" />

                <StackPanel Margin="0,4,0,0" HorizontalAlignment="Left">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryLight2}"
                        Text="Section:" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryColor}"
                        Text="{Binding Beam.Section.DisplayName}" />
                </StackPanel>
            </StackPanel>

            <!--  Right: Reason and small KPIs  -->
            <StackPanel
                Grid.Column="1"
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                Orientation="Vertical">
                <StackPanel Margin="0,4,0,0" HorizontalAlignment="Right">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryLight2}"
                        Text="Reason:" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryColor}"
                        Text="{Binding Utilization.MaxUtilizationDescription}" />
                </StackPanel>

                <!--  KPI row  -->
                <!--
                <StackPanel
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <StackPanel
                        Width="100"
                        HorizontalAlignment="Right"
                        Orientation="Vertical">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource PrimaryLight2}"
                            Text="Cr" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryLight1}"
                            Text="{Binding Cr, FallbackValue='0 kN'}" />
                    </StackPanel>

                    <StackPanel
                        Width="120"
                        HorizontalAlignment="Right"
                        Orientation="Vertical">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource PrimaryLight2}"
                            Text="Tr" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryLight1}"
                            Text="{Binding Tr, FallbackValue='0 kN'}" />
                    </StackPanel>
                </StackPanel>-->
            </StackPanel>
        </Grid>
    </Border>
</UserControl>