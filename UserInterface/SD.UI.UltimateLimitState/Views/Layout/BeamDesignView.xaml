<UserControl
    x:Class="SD.UI.UltimateLimitState.Views.BeamDesignView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:SD.UI.UltimateLimitState.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="clr-namespace:SD.UI.Constants;assembly=SD.UI"
    xmlns:viewmodels="clr-namespace:SD.UI.UltimateLimitState.ViewModels"
    xmlns:views="clr-namespace:SD.UI.UltimateLimitState.Views"
    x:Name="BeamDesignViewUserControl"
    d:DataContext="{d:DesignInstance Type=viewmodels:BeamDesignViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource MaterialDesignPaper}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SD.UI;component/Styles/Global.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid ScrollViewer.CanContentScroll="True" Visibility="{Binding HasSelectedLoadCaseCombination, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="450" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid Margin="8,0,0,0">
                <Border
                    Margin="0,0,-6,0"
                    Padding="4,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                    <materialDesign:PopupBox
                        IsEnabled="{Binding ProcessModel.IsFemModelLoaded}"
                        PlacementMode="RightAndAlignTopEdges"
                        PopupContentTemplate="{StaticResource BeamSelectionPopupTemplate}"
                        StaysOpen="True"
                        ToolTip="Select a beam filter method.">
                        <materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PackIcon
                                Width="{StaticResource IconSize}"
                                Height="{StaticResource IconSize}"
                                Margin="4"
                                Foreground="{StaticResource PrimaryColor}"
                                Kind="Filter" />
                        </materialDesign:PopupBox.ToggleContent>
                    </materialDesign:PopupBox>
                </Border>
                <DataGrid
                    Margin="-8,0,-4,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="false"
                    ColumnHeaderHeight="41"
                    ColumnWidth="Auto"
                    ItemsSource="{Binding DisplayedResults}"
                    RowHeight="32"
                    SelectedItem="{Binding SelectedBeamResult, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Style="{StaticResource MaterialDesignDataGrid}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <i:Interaction.Behaviors>
                        <behaviors:DataGridScrollIntoViewBehavior />
                        <behaviors:NavigateDataGridContextMenuBehavior
                            CanCopyCells="False"
                            ShowInAnotherViewCommand="{Binding ShowInAnotherViewCommand}"
                            ShowInAnotherViewText="Show in Data view" />
                    </i:Interaction.Behaviors>
                    <DataGrid.Resources>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding SelectedBeamResultChangedCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            MinWidth="66"
                            Binding="{Binding Beam.Number}"
                            Header="Beam"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            MinWidth="58"
                            Binding="{Binding LoadCaseNumber}"
                            Header="LCC"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="115"
                            Binding="{Binding Utilization.MaxUtilizationPercentage, Converter={StaticResource DoubleTwoDecimalsConverter}}"
                            Header="Utilisation"
                            IsReadOnly="True" />
                        <!--<DataGridTextColumn
                            Width="60"
                            Binding="{Binding Beam.Section.TypeDisplay}"
                            Header="Type"
                            IsReadOnly="True" />-->
                        <!--<DataGridTextColumn
                            MinWidth="110"
                            Binding="{Binding Beam.Section.DisplayName}"
                            Header="Property"
                            IsReadOnly="True" />-->
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                Margin="4,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Focusable="False"
                IsEnabled="False" />

            <Border
                Grid.Column="2"
                MinHeight="250"
                Margin="0,0,0,0"
                BorderBrush="{DynamicResource SecondaryLight5}"
                BorderThickness="0,0,0,0">
                <ContentControl prism:RegionManager.RegionName="{x:Static ui:RegionNames.BeamFemModelRegion}" />
            </Border>

            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Focusable="False"
                IsEnabled="False" />

            <views:SelectedBeamDetailsView Grid.Column="4" />

            <StackPanel
                Grid.Column="4"
                Margin="48,68"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Margin="8"
                    Command="{Binding ReCalculateCommand}"
                    IsEnabled="{Binding HasUlsCalcUpdates, FallbackValue=False}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                    ToolTip="Calculate modified members">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="CalculatorVariant" />
                </Button>
                <Button
                    Margin="8"
                    Command="{Binding ExcelExportCommand}"
                    IsEnabled="{Binding DisplayedResults, Converter={StaticResource InvertedObjectNullToVisibilityConverter}}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                    ToolTip="Export to Excel">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="MicrosoftExcel" />
                </Button>
                <!--<Button
                    Margin="8"
                    Command="{Binding MathcadExportCommand}"
                    IsEnabled="{Binding SelectedBeamResult, Converter={StaticResource BeamTypeConverter}, FallbackValue=False}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                    ToolTip="Export to Mathcad">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Margin="4,0,0,0"
                        Kind="Export" />
                </Button>-->

            </StackPanel>
        </Grid>
        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding HasSelectedLoadCaseCombination, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="24"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                Text="No Load Case Combinations selected"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="2"
                Margin="24"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="Run a calculation for at least one Load Case Combination"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>