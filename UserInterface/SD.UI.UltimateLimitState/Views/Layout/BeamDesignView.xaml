<UserControl
    x:Class="SD.UI.UltimateLimitState.Views.BeamDesignView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="clr-namespace:SD.UI.Constants;assembly=SD.UI"
    xmlns:viewmodels="clr-namespace:SD.UI.UltimateLimitState.ViewModels"
    xmlns:views="clr-namespace:SD.UI.UltimateLimitState.Views"
    x:Name="BeamDesignViewUserControl"
    d:DataContext="{d:DesignInstance Type=viewmodels:BeamDesignViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource MaterialDesignPaper}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SD.UI;component/Styles/Global.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="DesignLengthPopupTemplate">
                <StackPanel Margin="0,-8" DataContext="{Binding DataContext, ElementName=BeamDesignViewUserControl}">
                    <RadioButton
                        Margin="12"
                        Command="{Binding AllBeamsChangedCommand}"
                        IsChecked="{Binding AllBeamsChecked}"
                        ToolTip="Display all beams.">
                        <TextBlock
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Text="All Beams" />
                    </RadioButton>
                    <RadioButton
                        Margin="12"
                        Command="{Binding DisplayedGroupChangedCommand}"
                        IsChecked="{Binding DisplayedGroupChecked}"
                        ToolTip="Show displayed groups.">
                        <TextBlock
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Text="Displayed Group" />
                    </RadioButton>
                    <RadioButton
                        Margin="12"
                        Command="{Binding SelectedBeamsChangedCommand}"
                        IsChecked="{Binding SelectedBeamsChecked}"
                        IsEnabled="{Binding HasSelectedBeams}"
                        ToolTip="Display selected beams in primary model.">
                        <TextBlock
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Text="Selected Beams" />
                    </RadioButton>
                    <RadioButton
                        Margin="12"
                        Command="{Binding FailedBeamsChangedCommand}"
                        IsChecked="{Binding FailedBeamsChecked}"
                        ToolTip="Display failed beams only. Based on the allowable ULS design capacity.">
                        <TextBlock
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Text="Failed Beams" />
                    </RadioButton>
                    <Grid MinWidth="150" Margin="12">
                        <TextBox
                            Margin="8,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="ULS Design Capacity"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding AllowableUlsDesignCapacity}" />
                        <Button
                            Width="16"
                            Height="16"
                            Margin="8,0"
                            HorizontalAlignment="Right"
                            Command="{Binding FailedBeamsChangedCommand}"
                            Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon
                                Width="12"
                                Height="12"
                                Kind="Magnify" />
                        </Button>
                    </Grid>
                    <Grid MinWidth="155" Margin="12">
                        <TextBox
                            Margin="8,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="Filter by beam number."
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding BeamNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Width="16"
                            Height="16"
                            Margin="8,0"
                            HorizontalAlignment="Right"
                            Command="{Binding SetBeamNumberCommand}"
                            Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon
                                Width="12"
                                Height="12"
                                Kind="Magnify" />
                        </Button>
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid ScrollViewer.CanContentScroll="True" Visibility="{Binding HasSelectedLoadCaseCombination, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="450" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid Margin="8,0,0,0">
                <Border
                    Margin="0,0,-6,0"
                    Padding="8,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Background="{StaticResource MaterialDesignLightBackground}">
                    <materialDesign:PopupBox
                        IsEnabled="{Binding ProcessModel.IsFemModelLoaded}"
                        PlacementMode="RightAndAlignTopEdges"
                        PopupContentTemplate="{StaticResource DesignLengthPopupTemplate}"
                        StaysOpen="True"
                        ToolTip="Select a design length, for the beam element contour.">
                        <materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PackIcon
                                Width="{StaticResource IconSize}"
                                Height="{StaticResource IconSize}"
                                Foreground="{StaticResource PrimaryColor}"
                                Kind="Filter" />
                        </materialDesign:PopupBox.ToggleContent>
                    </materialDesign:PopupBox>
                </Border>
                <DataGrid
                    Margin="-8,0,-4,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="false"
                    ColumnHeaderHeight="38"
                    ColumnWidth="Auto"
                    ItemsSource="{Binding DisplayedResults}"
                    RowHeight="34.5"
                    SelectedItem="{Binding SelectedBeamResult, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionMode="Single"
                    Style="{StaticResource MaterialDesignDataGrid}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding SelectedBeamResultChangedCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            MinWidth="66"
                            Binding="{Binding Beam.Number}"
                            Header="Beam"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            MinWidth="58"
                            Binding="{Binding LoadCaseNumber}"
                            Header="LCC"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="115"
                            Binding="{Binding Utilization.MaxUtilizationPercentage, Converter={StaticResource DoubleTwoDecimalsConverter}}"
                            Header="Utilisation"
                            IsReadOnly="True" />
                        <!--<DataGridTextColumn
                            Width="60"
                            Binding="{Binding Beam.Section.TypeDisplay}"
                            Header="Type"
                            IsReadOnly="True" />-->
                        <!--<DataGridTextColumn
                            MinWidth="110"
                            Binding="{Binding Beam.Section.DisplayName}"
                            Header="Property"
                            IsReadOnly="True" />-->
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                Margin="4,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Focusable="False"
                IsEnabled="False" />

            <Border
                Grid.Column="2"
                MinHeight="250"
                Margin="0,0,0,0"
                BorderBrush="{DynamicResource SecondaryLight5}"
                BorderThickness="0,0,0,0">
                <ContentControl prism:RegionManager.RegionName="{x:Static ui:RegionNames.BeamFemModelRegion}" />
            </Border>

            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Focusable="False"
                IsEnabled="False" />

            <views:SelectedBeamDetailsView Grid.Column="4" />

            <StackPanel
                Grid.Column="4"
                Margin="48,68"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Margin="8"
                    Command="{Binding ReCalculateCommand}"
                    IsEnabled="{Binding HasUlsCalcUpdates, FallbackValue=False}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                    ToolTip="Calculate modified members">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="CalculatorVariant" />
                </Button>
                <Button
                    Margin="8"
                    Command="{Binding ExcelExportCommand}"
                    IsEnabled="{Binding DisplayedResults, Converter={StaticResource InvertedObjectNullToVisibilityConverter}}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                    ToolTip="Export to Excel">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="MicrosoftExcel" />
                </Button>
                <!--<Button
                    Margin="8"
                    Command="{Binding MathcadExportCommand}"
                    IsEnabled="{Binding SelectedBeamResult, Converter={StaticResource BeamTypeConverter}, FallbackValue=False}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                    ToolTip="Export to Mathcad">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Margin="4,0,0,0"
                        Kind="Export" />
                </Button>-->

            </StackPanel>
        </Grid>
        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding HasSelectedLoadCaseCombination, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="24"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                Text="No Load Case Combinations selected"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="2"
                Margin="24"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="Run a calculation for at least one Load Case Combination"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>