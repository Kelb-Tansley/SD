<UserControl
    x:Class="SD.UI.Main.Views.ToolBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:SD.UI.Main.Behaviors"
    xmlns:constants="clr-namespace:SD.Core.Shared.Constants;assembly=SD.Core.Shared"
    xmlns:converters="clr-namespace:SD.UI.Converters;assembly=SD.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SD.UI.Models;assembly=SD.UI"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:SD.UI.Main.ViewModels"
    x:Name="DesignLengthPopupBoxUserControl"
    d:DataContext="{d:DesignInstance Type=viewmodels:ToolBarViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SD.UI;component/Styles/Global.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ComboBoxValueToStringConverter x:Key="ComboBoxValueToStringConverter" />
            <converters:ComboBoxValueToBoolConverter x:Key="ComboBoxValueToBoolConverter" />
            <converters:ComboBoxValueToLoadCaseConverter x:Key="ComboBoxValueToLoadCaseConverter" />
            <Storyboard x:Key="FlickerAnimation" RepeatBehavior="0:0:5">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="0.3" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0.3" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="0.3" />
                    <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <DataTemplate x:Key="DesignLengthPopupTemplate">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            Margin="8,0,8,16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkSage}"
                            Text="Design Limits:" />
                        <ListBox
                            Margin="0,-8,0,0"
                            materialDesign:ListBoxAssist.IsToggle="False"
                            materialDesign:ListBoxItemAssist.ShowSelection="True"
                            materialDesign:RippleAssist.IsDisabled="True"
                            DataContext="{Binding DataContext, ElementName=DesignLengthPopupBoxUserControl}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding BeamAxisDisplay.DesignableBeams}"
                            SelectedItem="{Binding BeamAxisDisplay.SelectedDesignableBeam}"
                            Style="{StaticResource MaterialDesignListBox}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding BeamAxisDisplay.SelectedDesignableBeamChangedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ListBox>
                        <Separator Margin="0" />
                        <TextBlock
                            Margin="8,8,8,16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkSage}"
                            Text="Beam Length:" />
                        <ListBox
                            Margin="0,-8,0,0"
                            materialDesign:ListBoxAssist.IsToggle="False"
                            materialDesign:ListBoxItemAssist.ShowSelection="True"
                            materialDesign:RippleAssist.IsDisabled="True"
                            DataContext="{Binding DataContext, ElementName=DesignLengthPopupBoxUserControl}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding BeamAxisDisplay.DesignLengths}"
                            SelectedItem="{Binding BeamAxisDisplay.SelectedDesignLength}"
                            Style="{StaticResource MaterialDesignListBox}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding BeamAxisDisplay.SelectedDesignLengthChangedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ListBox>
                        <Separator Margin="0" />
                        <TextBlock
                            Margin="8,8,8,16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkSage}"
                            Text="Beam K Factor:" />
                        <ListBox
                            Margin="0,-8,0,0"
                            materialDesign:ListBoxAssist.IsToggle="False"
                            materialDesign:ListBoxItemAssist.ShowSelection="True"
                            materialDesign:RippleAssist.IsDisabled="True"
                            DataContext="{Binding DataContext, ElementName=DesignLengthPopupBoxUserControl}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding BeamAxisDisplay.KFactors}"
                            SelectedItem="{Binding BeamAxisDisplay.SelectedKFactor}"
                            Style="{StaticResource MaterialDesignListBox}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding BeamAxisDisplay.SelectedKFactorChangedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ListBox>
                        <Separator Margin="0" />
                        <TextBlock
                            Margin="8,8,8,16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkSage}"
                            Text="Beam slenderness ratio:" />
                        <ListBox
                            Margin="0,-8,0,0"
                            materialDesign:ListBoxAssist.IsToggle="False"
                            materialDesign:ListBoxItemAssist.ShowSelection="True"
                            materialDesign:RippleAssist.IsDisabled="True"
                            DataContext="{Binding DataContext, ElementName=DesignLengthPopupBoxUserControl}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding BeamAxisDisplay.SlendernessOrientations}"
                            SelectedItem="{Binding BeamAxisDisplay.SelectedSlendernessOrientation}"
                            Style="{StaticResource MaterialDesignListBox}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding BeamAxisDisplay.SelectedSlendernessOrientationChangedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            Margin="8,0,8,16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkSage}"
                            Text="Beam ULS Utilization:" />
                        <ListBox
                            Margin="0,-8,0,0"
                            materialDesign:ListBoxAssist.IsToggle="False"
                            materialDesign:ListBoxItemAssist.ShowSelection="True"
                            materialDesign:RippleAssist.IsDisabled="True"
                            DataContext="{Binding DataContext, ElementName=DesignLengthPopupBoxUserControl}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding BeamAxisDisplay.UlsUtilizationTypes}"
                            SelectedItem="{Binding BeamAxisDisplay.SelectedUlsUtilizationType}"
                            Style="{StaticResource MaterialDesignListBox}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding BeamAxisDisplay.SelectedUlsUtilizationTypeChangedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="NonDesignablePropertiesPopupTemplate">
                <StackPanel>
                    <TextBlock
                        Margin="8,0,8,20"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource DarkSage}"
                        Text="The following beam properties cannot be designed:" />
                    <ListBox
                        Margin="0,-16"
                        DataContext="{Binding DataContext, ElementName=DesignLengthPopupBoxUserControl}"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding FemModelParameters.NonDesignableSections}"
                        Style="{StaticResource MaterialDesignListBox}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ToolBarTray HorizontalAlignment="Stretch">
        <ToolBar Style="{StaticResource MaterialDesignToolBar}">
            <ComboBox
                Width="130"
                Margin="1,0,16,0"
                materialDesign:HintAssist.Hint="Design Code"
                IsEnabled="False"
                ItemsSource="{x:Static constants:DesignCodes.AllDesignCodes}"
                SelectedItem="{Binding DesignModel.DesignCode}"
                Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding DesignCodeChangedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
            <CheckBox
                Margin="8,0"
                Command="{Binding RefreshCommand}"
                Content="Auto Design Length"
                IsChecked="{Binding DesignModel.IsDesignLengthCalculated}"
                Style="{StaticResource MaterialDesignFilterChipSecondaryCheckBox}"
                ToolTip="The auto design length calulator uses allignment and restraint conditions &#x0a;to determine the design length of the beam element. If unselected, the beam &#x0a;length will be that of the node to node length in Strand7." />
        </ToolBar>
        <ToolBar Style="{StaticResource MaterialDesignToolBar}">
            <materialDesign:PopupBox
                Margin="8,10"
                IsEnabled="{Binding ProcessModel.IsFemModelLoaded}"
                PlacementMode="RightAndAlignTopEdges"
                PopupContentTemplate="{StaticResource DesignLengthPopupTemplate}"
                StaysOpen="False"
                ToolTip="Select a design length, for the beam element contour.">
                <materialDesign:PopupBox.ToggleContent>
                    <materialDesign:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Margin="16,0"
                        Foreground="{StaticResource PrimaryColor}"
                        Kind="Beaker" />
                </materialDesign:PopupBox.ToggleContent>
            </materialDesign:PopupBox>
            <Separator />
            <Button
                Margin="5,10"
                materialDesign:ElevationAssist.Elevation="Dp0"
                Command="{Binding CalculateCommand}"
                IsEnabled="{Binding CanCalculate}"
                Style="{StaticResource MaterialDesignFlatButton}"
                ToolTip="Calculate utilisations.">
                <materialDesign:PackIcon
                    Width="{StaticResource IconSize}"
                    Height="{StaticResource IconSize}"
                    Kind="Calculator" />
            </Button>

            <Button
                Margin="5,10"
                materialDesign:ElevationAssist.Elevation="Dp0"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding ProcessModel.IsFemModelLoaded}"
                Style="{StaticResource MaterialDesignFlatButton}"
                ToolTip="Refreshing the Strand7 model will reload the model and results file and re-calculate.">
                <materialDesign:PackIcon
                    Width="{StaticResource IconSize}"
                    Height="{StaticResource IconSize}"
                    Kind="Refresh" />
            </Button>
            <Button
                Margin="5,10,10,10"
                materialDesign:ElevationAssist.Elevation="Dp0"
                Command="{Binding OpenSettingsCommand}"
                IsEnabled="{Binding ProcessModel.IsFemModelLoaded}"
                Style="{StaticResource MaterialDesignFlatButton}">
                <materialDesign:PackIcon
                    Width="{StaticResource IconSize}"
                    Height="{StaticResource IconSize}"
                    Kind="Cog" />
            </Button>
            <Separator />
            <Button
                Margin="6,0,0,0"
                materialDesign:ElevationAssist.Elevation="Dp0"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding DesignModel.IsSaveEnabled}"
                Style="{StaticResource MaterialDesignFlatButton}"
                ToolTip="Save edited K values to database.">
                <materialDesign:PackIcon
                    Width="{StaticResource IconSize}"
                    Height="{StaticResource IconSize}"
                    Kind="ContentSave" />
            </Button>
            <materialDesign:PopupBox
                Margin="8,10"
                IsEnabled="{Binding ProcessModel.IsFemModelLoaded}"
                PlacementMode="RightAndAlignTopEdges"
                PopupContentTemplate="{StaticResource NonDesignablePropertiesPopupTemplate}"
                StaysOpen="True"
                ToolTip="Number of non-designable sections in the model. All beams related are not designed."
                Visibility="{Binding FemModelParameters.NonDesignableSections, Converter={StaticResource ListCountToVisibilityConverter}}">
                <i:Interaction.Behaviors>
                    <behaviors:FlickerOnVisibilityBehavior StoryboardName="FlickerAnimation" TargetElement="{Binding ElementName=NonDesignablePackIcon}" />
                </i:Interaction.Behaviors>
                <materialDesign:PopupBox.ToggleContent>
                    <StackPanel
                        x:Name="NonDesignablePackIcon"
                        Margin="14,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="{StaticResource IconSize}"
                            Height="{StaticResource IconSize}"
                            Margin="0,0,4,0"
                            Foreground="Red"
                            Kind="AlertOutline" />
                        <TextBlock
                            Margin="-6,0,0,8"
                            VerticalAlignment="Center"
                            Foreground="Red"
                            Text="{Binding FemModelParameters.NonDesignableSections, Converter={StaticResource ListToCountConverter}}" />
                    </StackPanel>
                </materialDesign:PopupBox.ToggleContent>
            </materialDesign:PopupBox>
        </ToolBar>
    </ToolBarTray>
</UserControl>
