<UserControl
    x:Class="SD.UI.Main.Views.BrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SD.UI.Models;assembly=SD.UI"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:SD.UI.Main.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:BrowserViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource BlindWhisperingSage}"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <materialDesign:Card
            Grid.Row="1"
            MaxWidth="600"
            Margin="32"
            HorizontalAlignment="Right"
            UniformCornerRadius="20">
            <Grid Margin="16" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="16,16,16,32"
                    HorizontalAlignment="Left"
                    Foreground="{StaticResource DarkText}"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="Beam Design" />
                <Button
                    Grid.Row="1"
                    Height="110"
                    Margin="0,0,0,32"
                    Padding="0,0,32,0"
                    HorizontalAlignment="Left"
                    materialDesign:ButtonAssist.CornerRadius="4"
                    Command="{Binding BrowseFileCommand}"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="120"
                            Height="100"
                            Kind="OpenInApp"
                            Opacity="0.2" />
                        <StackPanel
                            Width="400"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{StaticResource DarkText}"
                                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                Text="Browse" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource DarkText}"
                                Style="{StaticResource MaterialDesignTextBlock}"
                                Text="Open Strand7 file in search" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <TextBlock
                    Grid.Row="2"
                    Margin="16"
                    HorizontalAlignment="Left"
                    FontWeight="DemiBold"
                    Foreground="{StaticResource DarkText}"
                    Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                    Text="Recently Opened"
                    Visibility="{Binding HasFileHistories, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ListBox
                    Grid.Row="3"
                    materialDesign:ScrollBarAssist.ButtonsVisibility="Visible"
                    ItemsSource="{Binding FileHistories}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding Path=SelectedFile, Mode=TwoWay}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding FileSelectedCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:FileHistoryDisplayModel}">
                            <Border
                                x:Name="Border"
                                Padding="8"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton
                                        Height="40"
                                        Margin="0"
                                        Content="{Binding FileCode}"
                                        IsChecked="True"
                                        Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding FilePath}">
                                        <TextBlock
                                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            FontSize="10"
                                            Style="{StaticResource MaterialDesignTextBlock}"
                                            Text="{Binding FilePath}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card
            Grid.Row="1"
            Grid.Column="1"
            MaxWidth="600"
            Margin="32"
            HorizontalAlignment="Left"
            UniformCornerRadius="20">
            <StackPanel Margin="16">
                <TextBlock
                    Margin="16,16,16,32"
                    HorizontalAlignment="Left"
                    Foreground="{StaticResource DarkText}"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="Model Tools" />
                <Button
                    Grid.Row="1"
                    Height="110"
                    Margin="0,0,0,32"
                    Padding="0,0,32,0"
                    HorizontalAlignment="Left"
                    materialDesign:ButtonAssist.CornerRadius="4"
                    Command="{Binding TankModelCommand}"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="120"
                            Height="100"
                            Kind="Cylinder"
                            Opacity="0.2" />
                        <StackPanel
                            Width="400"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{StaticResource DarkText}"
                                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                Text="Tank Model" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource DarkText}"
                                Style="{StaticResource MaterialDesignTextBlock}"
                                Text="Generate cylindrical storage tank plate element model" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button
                    Grid.Row="1"
                    Height="110"
                    Margin="0,0,0,32"
                    Padding="0,0,32,0"
                    HorizontalAlignment="Left"
                    materialDesign:ButtonAssist.CornerRadius="4"
                    Command="{Binding BeamWindLoadCommand}"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="120"
                            Height="100"
                            Kind="Windsock"
                            Opacity="0.2" />
                        <StackPanel
                            Width="400"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{StaticResource DarkText}"
                                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                Text="Beam Wind Loads" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource DarkText}"
                                Style="{StaticResource MaterialDesignTextBlock}"
                                Text="Apply shape factored and vectorised wind loads to beam elements" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
