<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>AnyCPU;x86;x64;ARM64</Platforms>
		<UseAppHost>true</UseAppHost>
		<PublishSingleFile>false</PublishSingleFile>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>Assets\Icons\appicon.ico</ApplicationIcon>
		<PackageIcon>Assets\Icons\appicon.png</PackageIcon>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<AnalysisLevel>latest</AnalysisLevel>
		<CodeSigningEnabled>false</CodeSigningEnabled>
		<SignToolPath Condition="'$(SignToolPath)' == ''">signtool</SignToolPath>
		<CodeSigningCertificateThumbprint></CodeSigningCertificateThumbprint>
		<CodeSigningTimestampUrl>http://timestamp.digicert.com</CodeSigningTimestampUrl>
		<CodeSigningDigestAlgorithm>SHA256</CodeSigningDigestAlgorithm>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
		<PackageReference Include="Microsoft.Identity.Client" Version="4.83.3" />
		<PackageReference Include="Microsoft.Identity.Client.Desktop" Version="4.83.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Prism.Unity" Version="9.0.537" />
		<PackageReference Include="Prism.Wpf" Version="9.0.537" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.7" />
		<PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.7" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\SD.Core.Infrastructure\SD.Core.Infrastructure.csproj" />
		<ProjectReference Include="..\Data\SD.Data\SD.Data.csproj" />
		<ProjectReference Include="..\Domain\SD.Element.Design.Sans\SD.Element.Design.Sans.csproj" />
		<ProjectReference Include="..\Domain\SD.Element.Design.AS\SD.Element.Design.AS.csproj" />
		<ProjectReference Include="..\Domain\SD.Element.Design\SD.Element.Design.csproj" />
		<ProjectReference Include="..\Domain\SD.Fem.Strand7\SD.Fem.Strand7.csproj" />
		<ProjectReference Include="..\Domain\SD.MathcadPrime\SD.MathcadPrime.csproj" />
		<ProjectReference Include="..\UserInterface\SD.UI.Main\SD.UI.Main.csproj" />
		<ProjectReference Include="..\UserInterface\SD.UI.Tools\SD.UI.Tools.csproj" />
		<ProjectReference Include="..\UserInterface\SD.UI.UltimateLimitState\SD.UI.UltimateLimitState.csproj" />
		<ProjectReference Include="..\UserInterface\SD.UI\SD.UI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appSettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Assets\Icons\appicon.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Assets\Icons\appicon.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Logger.config">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Core\SD.Core.Shared\Models\" />
	</ItemGroup>

	<ItemGroup>
	  <None Include=".github\copilot-instructions.md" />
	  <None Include="Installer\SD.Installer\SD.Installer.vdproj" />
	</ItemGroup>

	<Target Name="SignBuildArtifacts" AfterTargets="Build" Condition="'$(CodeSigningEnabled)' == 'true' and '$(CodeSigningCertificateThumbprint)' != ''">
		<ItemGroup>
			<ArtifactsToSign Include="$(TargetDir)$(AssemblyName).exe" Condition="Exists('$(TargetDir)$(AssemblyName).exe')" />
			<ArtifactsToSign Include="$(TargetDir)$(AssemblyName).dll" Condition="Exists('$(TargetDir)$(AssemblyName).dll')" />
		</ItemGroup>

		<Exec Command="$(SignToolPath) sign /sha1 $(CodeSigningCertificateThumbprint) /fd $(CodeSigningDigestAlgorithm) /td $(CodeSigningDigestAlgorithm) /tr &quot;$(CodeSigningTimestampUrl)&quot; &quot;%(ArtifactsToSign.Identity)&quot;" StandardOutputImportance="High" Condition="'@(ArtifactsToSign)' != ''" />
	</Target>

</Project>
